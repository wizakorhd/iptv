<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily local refresh of the curated IPTV playlist + EPG, pushed to GitHub.

  Install:
    cp com.wizakorhd.iptv.refresh.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.wizakorhd.iptv.refresh.plist
  Unload:
    launchctl unload ~/Library/LaunchAgents/com.wizakorhd.iptv.refresh.plist

  Edit the two <string> paths below if your repo lives elsewhere.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wizakorhd.iptv.refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/arwen/Development/legolas/iptv/refresh-local.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/arwen/Development/legolas/iptv</string>

    <!-- Run every day at 06:15 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>15</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/arwen/Development/legolas/iptv/refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/arwen/Development/legolas/iptv/refresh.log</string>
</dict>
</plist>
